{
  "name": "daily-tasks-runner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "أتمتة يومية: سحب المهام الواردة، استخراج بيانات المعاملة من ملف PDF، تسجيلها في ملفي إكسل، ثم وضع المعاملة تحت التنفيذ.",
  "scripts": {
