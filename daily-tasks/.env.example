# ============================================================
# انسخ هذا الملف باسم .env ثم عبئ القيم الحقيقية
#   cp .env.example .env      (ماك / لينكس)
#   copy .env.example .env    (ويندوز)
#
# ملف .env مستثنى من Git ولن يرفع للمستودع.
# لا تضع كلمة المرور في أي ملف آخر.
# ============================================================

# --- عنوان النظام (إلزامي) ---
# الصفحة الرئيسية أو صفحة تسجيل الدخول
SYSTEM_BASE_URL=
# صفحة المهام الواردة. اتركها فارغة إذا كان الوصول إليها عبر القائمة بعد الدخول.
TASKS_URL=

# --- بيانات الدخول (إلزامي) ---
SYSTEM_USERNAME=
SYSTEM_PASSWORD=

# --- سلوك التشغيل ---
# false = وضع التجربة: يقرأ ويسجل في الإكسل ولا يضغط "تحت التنفيذ" إطلاقا.
# true  = وضع التنفيذ الفعلي: يضغط "تحت التنفيذ" ويكتب التعليق ويحفظ.
# ابدأ دائما بـ false حتى تتأكد أن الاستخراج صحيح.
AUTO_MARK_IN_PROGRESS=false

# النص الذي يكتب في خانة الملاحظة عند وضع المعاملة تحت التنفيذ
IN_PROGRESS_COMMENT=المعاملة تحت التنفيذ

# true = تشغيل المتصفح مخفيا (مناسب للجدولة التلقائية)
# false = إظهار المتصفح لمتابعة ما يحدث (مناسب لأول تجربة)
HEADLESS=true

# أقصى عدد مهام تعالج في التشغيلة الواحدة (حماية من الحلقات غير المتوقعة)
MAX_TASKS_PER_RUN=200

# --- مسارات المخرجات ---
# مجلد ملفات الإكسل. غيره لمجلد OneDrive أو مجلد الشبكة إذا رغبت.
OUTPUT_DIR=./output
PHYSIO_WORKBOOK=مرضى_العلاج_الطبيعي.xlsx
GI_WORKBOOK=مرضى_الجهاز_الهضمي.xlsx
# ملفات PDF المحملة تحفظ هنا للرجوع إليها
PDF_DIR=./pdfs

# --- استخراج بيانات الـPDF بالذكاء الاصطناعي (اختياري لكنه مهم) ---
# يستخدم فقط عندما يكون الـPDF ممسوحا ضوئيا (صورة بلا نص).
# اتركه فارغا للاعتماد على الاستخراج النصي فقط.
OPENAI_API_KEY=
OPENAI_DOCUMENT_MODEL=gpt-4.1-mini
